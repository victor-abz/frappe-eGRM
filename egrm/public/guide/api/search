/submit-10","page_id":"/docs/citizen/submit","tags":[],"type":"text","url":"/docs/citizen/submit#say-what-kind-of-problem-it-is","content":"**Category** — what your complaint is about:"},"37":{"id":"/docs/citizen/submit-11","page_id":"/docs/citizen/submit","tags":[],"type":"text","url":"/docs/citizen/submit#say-what-kind-of-problem-it-is","content":"Choice"},"38":{"id":"/docs/citizen/submit-12","page_id":"/docs/citizen/submit","tags":[],"type":"text","url":"/docs/citizen/submit#say-what-kind-of-problem-it-is","content":"Use it when"},"39":{"id":"/docs/citizen/submit-13","page_id":"/docs/citizen/submit","tags":[],"type":"text","url":"/docs/citizen/submit#say-what-kind-of-problem-it-is","content":"**Complaint**"},"40":{"id":"/docs/citizen/submit-14","page_id":"/docs/citizen/submit","tags":[],"type":"text","url":"/docs/citizen/submit#say-what-kind-of-problem-it-is","content":"Something went wrong and you want it put right"},"41":{"id":"/docs/citizen/submit-15","page_id":"/docs/citizen/submit","tags":[],"type":"text","url":"/docs/citizen/submit#say-what-kind-of-problem-it-is","content":"**Service Issue**"},"42":{"id":"/docs/citizen/submit-16","page_id":"/docs/citizen/submit","tags":[],"type":"text","url":"/docs/citizen/submit#say-what-kind-of-problem-it-is","content":"A service is not working, is late, or is unavailable"},"43":{"id":"/docs/citizen/submit-17","page_id":"/docs/citizen/submit","tags":[],"type":"text","url":"/docs/citizen/submit#say-what-kind-of-problem-it-is","content":"**Question**"},"44":{"id":"/docs/citizen/submit-18","page_id":"/docs/citizen/submit","tags":[],"type":"text","url":"/docs/citizen/submit#say-what-kind-of-problem-it-is","content":"You want information, not a correction"},"45":{"id":"/docs/citizen/submit-19","page_id":"/docs/citizen/submit","tags":[],"type":"text","url":"/docs/citizen/submit#say-what-kind-of-problem-it-is","content":"**Other**"},"46":{"id":"/docs/citizen/submit-20","page_id":"/docs/citizen/submit","tags":[],"type":"text","ur