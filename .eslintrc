{
	"env": {
		"browser": true,
		"node": true,
		"es2022": true
	},
	"parserOptions": {
		"sourceType": "module"
	},
	"extends": "eslint:recommended",
	"rules": {
		"indent": "off",
		"brace-style": "off",
		"no-mixed-spaces-and-tabs": "off",
		"no-useless-escape": "off",
		"space-unary-ops": ["error", { "words": true }],
		"linebreak-style": "off",
		"quotes": ["off"],
		"semi": "off",
		"camelcase": "off",
		"no-unused-vars": "off",
		"no-console": ["warn"],
		"no-extra-boolean-cast": ["off"],
		"no-control-regex": ["off"],
	},
	"root": true,
	"globals": {
		"frappe": true,
		"Vue": true,
		"SetVueGlobals": true,
		"__": true,
		"repl": true,
		"Class": true,
		"locals": true,
		"cint": true,
		"cstr": true,
		"cur_frm": true,
		"cur_dialog": true,
		"cur_page": true,
		"cur_list": true,
		"cur_tree": true,
		"msg_dialog": true,
		"is_null": true,
		"in_list": true,
		"has_common": true,
		"posthog": true,
		"has_words": true,
		"validate_email": true,
		"open_web_template_values_editor": true,
		"validate_name": true,
		"validate_phone": true,
		"validate_url": true,
		"get_number_format": true,
		"format_number": true,
		"format_currency": true,
		"comment_when": true,
		"open_url_post": true,
		"toTitle": true,
		"lstrip": true,
		"rstrip": true,
		"strip": true,
		"strip_html": true,
		"replace_all": true,
		"flt": true,
		"precision": true,
		"CREATE": true,
		"AMEND": true,
		"CANCEL": true,
		"copy_dict": true,
		"get_number_format_info": true,
		"strip_number_groups": true,
		"print_table": true,
		"Layout": true,
		"web_form_settings": true,
		"$c": true,
		"$a": true,
		"$i": true,
		"$bg": true,
		"$y": true,
		"$c_obj": true,
		"refresh_many": true,
		"refresh_field": true,
		"toggle_field": true,
		"get_field_obj": true,
		"get_query_params": true,
		"unhide_field": true,
		"hide_field": true,
		"set_field_options": true,
		"getCookie": true,
		"getCookies": true,
		"get_url_arg": true,
		"md5": true,
		"$": true,
		"jQuery": true,
		"moment": true,
		"hljs": true,
		"Awesomplete": true,
		"Sortable": true,
		"Showdown": true,
		"Taggle": true,
		"Gantt": true,
		"Slick": true,
		"Webcam": true,
		"PhotoSwipe": true,
		"PhotoSwipeUI_Default": true,
		"io": true,
		"JsBarcode": true,
		"L": true,
		"Chart": true,
		"DataTable": true,
		"Cypress": true,
		"cy": true,
		"it": true,
		"describe": true,
		"expect": true,
		"context": true,
		"before": true,
		"beforeEach": true,
		"after": true,
		"qz": true,
		"localforage": true,
		"extend_cscript": true,
		// Frappe's legacy form API: a `validate` handler cancels the save by
		// assigning `validated = false`. It is injected into the handler's
		// scope by the framework, so it has no declaration to find.
		"validated": true
	},
	"overrides": [
		{
			// The Project Setup Wizard is split across per-step modules that
			// Frappe's `page_js` hook CONCATENATES onto one script (see the
			// `page_js` block in hooks.py). They therefore share a single
			// script scope and reference each other by bare name — correct at
			// runtime, but invisible to a per-file linter.
			"files": [
				"egrm/public/js/grm_project_wizard/*.js",
				"egrm/egrm/page/grm_project_wizard/grm_project_wizard.js"
			],
			"globals": {
				"STEP_TITLES": true,
				"TOTAL_STEPS": true,
				"grm_render_bulk_toolbar": true,
				"grm_wire_bulk_table": true,
				"GRMProjectWizard": true,
				"GRMWizardStep1ProjectInfo": true,
				"GRMWizardStep2AdminUnits": true,
				"GRMWizardStep2AdminLevelsInner": true,
				"GRMWizardStep2AdminRegionsInner": true,
				"GRMWizardStep3IssueCategories": true,
				"GRMWizardStep4IssueTypes": true,
				"GRMWizardStep5CitizenLookups": true,
				"GRMWizardStep6NotificationTemplates": true,
				"GRMWizardStep7ProjectRoles": true,
				"GRMWizardStep8Departments": true,
				"GRMWizardStep9Users": true,
				"GRMWizardStep9UsersList": true,
				"GRMWizardStep9UserAdd": true,
				"GRMWizardStep9UserImport": true,
				"GRMWizardStep10Routing": true,
				"GRMWizardStep11SLAs": true,
				"GRMWizardStep12IssueStatuses": true,
				"GRMWizardStep13Activate": true
			}
		}
	]
}
