# Credentials for the sync load suite. Copy to `.env` in this directory and
# fill in the two blanks — `.env` is gitignored (.gitignore:27), `.env.example`
# is not, so never put real values in this file.
#
#   cp tests/load/.env.example tests/load/.env
#   $EDITOR tests/load/.env
#   ./tests/load/run.sh
#
# Nothing else needs to be set on the command line after that.

# Site the suite hits. Local bench by default; point it at staging to measure
# the deployed build instead.
#   local    http://egrm.local:8000
#   staging  https://egrm.risa.gov.rw
K6_BASE=http://egrm.local:8000

# A real account on K6_BASE, used by setup() to log in once and share the
# session cookie across every VU. Use a dedicated load-test user, not a
# personal or administrative login: the suite issues thousands of pulls as
# this user, and its entitlement decides how much data each pull carries.
#
# The account needs nothing beyond ordinary app access — whatever a field
# officer has is right. An account with no project assignments will pass the
# thresholds trivially and measure nothing.
K6_USER=
K6_PASS=
